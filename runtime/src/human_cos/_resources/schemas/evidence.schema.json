{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Item",
  "type": "object",
  "required": [
    "evidence_id",
    "case_id",
    "source_type",
    "source_timestamp",
    "ingested_at",
    "available_from",
    "visibility",
    "temporal_class",
    "fact_status",
    "source_quality",
    "fact_confidence",
    "snapshot_hash"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "content": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": "string"
    },
    "source_uri_or_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_from": {
      "type": "string",
      "format": "date-time"
    },
    "available_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "visibility": {
      "$ref": "visibility.schema.json"
    },
    "temporal_class": {
      "enum": [
        "PRE_T0",
        "POST_T0",
        "LATER_VERIFICATION_OF_PRE_T0_FACT"
      ]
    },
    "fact_status": {
      "enum": [
        "OBSERVED",
        "REPORTED",
        "INFERRED",
        "DISPUTED"
      ]
    },
    "source_quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fact_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_conflict_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
